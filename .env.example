# Copy to .env and fill in. .env is gitignored.

# Host/LAN address of this machine that is reachable FROM job containers and your browser.
# Do NOT use localhost/127.0.0.1 — job containers cannot reach it.
GITEA_ROOT_URL=http://192.168.1.10:3000/

# Runner registration token. Populate with: make token
RUNNER_TOKEN=

# Gitea admin account, created by: make admin
GITEA_ADMIN_USER=gitea
GITEA_ADMIN_PASSWORD=change-me
GITEA_ADMIN_EMAIL=gitea@example.com
